# Phase 0 migration profile. This file contains no credentials.
# Load these values in addition to the normal environment when validating the
# new platform path. It intentionally keeps every order path non-live.

IQ_ACCOUNT_TYPE=PRACTICE
DRY_RUN=true
MARTINGALE_ENABLED=false
MARTINGALE_MAX_STEPS=1
SCANNER_ENABLED=false
TELEGRAM_SIGNALS_ENABLED=false

# Future platform controls. Legacy code may ignore these until its adapter is
# migrated, but tests require the profile to remain fail-closed.
TRADING_ENVIRONMENT=SHADOW
LIVE_TRADING_ENABLED=false
PLATFORM_SHADOW_ENABLED=false
ALLOW_TELEGRAM_ACCOUNT_SWITCH=false
ALLOW_TELEGRAM_MARTINGALE=false
