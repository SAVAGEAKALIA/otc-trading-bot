# ===========================================
# OTC Trading Bot - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ----- TELEGRAM CONFIGURATION -----
# Get these from https://my.telegram.org
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# Channel ID to monitor for signals (use negative number for channels)
TG_CHANNEL_ID=-1001234567890

# Session name (stored in /data for persistence)
TG_SESSION_NAME=/app/data/otc_session

# Admin user IDs (comma-separated) - auto-added for self-bot
TG_ADMIN_IDS=

# ----- IQ OPTION CONFIGURATION -----
IQ_EMAIL=your_email@example.com
IQ_PASSWORD=your_password
IQ_ACCOUNT_TYPE=PRACTICE
# Options: PRACTICE or REAL

# ----- POSITION SIZING -----
SIZING_METHOD=fractional_kelly
# Options: fixed_amount, fixed_percentage, fractional_kelly

SIZING_FIXED_AMOUNT=1.0
SIZING_FIXED_PERCENTAGE=0.01
SIZING_KELLY_FRACTION=0.25
# Kelly options: 0.5 (½), 0.25 (¼), 0.125 (⅛)

SIZING_MIN_TRADE=1.0
SIZING_MAX_TRADE=50.0
SIZING_MAX_RISK_PERCENTAGE=0.05

# ----- RISK MANAGEMENT -----
MAX_DAILY_LOSS=50.0
MAX_CONSECUTIVE_LOSSES=3
DAILY_PROFIT_TARGET=100.0

# ----- TRADING SETTINGS -----
DEFAULT_DURATION=2
# Comma-separated execution whitelist. Keep at 2 until a verified
# out-of-sample cohort supports expanding it.
ALLOWED_TRADE_DURATIONS=2
SIGNAL_TIMEZONE=Africa/Lagos

# ----- AI ANALYSIS (Optional) -----
AI_ENABLED=false
AI_API_KEY=your_openai_api_key
AI_CONFIDENCE_THRESHOLD=0.7

# ----- PATTERN ANALYSIS -----
PATTERN_ANALYSIS_ENABLED=true
# Enable/disable pattern detection during trade analysis

PATTERN_FILTER_ENABLED=false
# If true, will warn when patterns conflict with signal direction

STRICT_PATTERN_FILTER=false
# If true, will SKIP trades when patterns strongly conflict with signal

# ----- NOTIFICATIONS -----
SEND_NOTIFICATIONS=true

# ----- LOGGING -----
LOG_FILE=/app/data/trade_log.json
DEBUG=false

# ----- CANDIDATE META-LABEL RESEARCH -----
# Records scanner-generated setups and paper outcomes only. It never places,
# blocks, or changes trades. Keep enabled until at least 3,000 resolved
# candidates spanning 60 UTC days have been collected.
CANDIDATE_RESEARCH_ENABLED=true
CANDIDATE_RESEARCH_DB=/app/data/candidate_research.sqlite

# ----- MACHINE-LEARNING COMPONENTS -----
# Directional source: lstm, catboost, both, or off. The later CatBoost
# candidate gate is controlled independently by ML_META_GATE.
ML_SIGNAL_SOURCE=lstm
# off: no CatBoost; shadow: log decisions only; enforce: reject candidates.
# Keep shadow until the artifact passes offline and practice validation.
ML_META_GATE=shadow
ML_CONTEXT_DB=/app/data/ml/market_context.sqlite
ML_MIN_PAYOUT=0.75
ML_MIN_EXPECTED_VALUE=0.02
ML_BYPASS_RISK_GATES=true

# ----- NEW PLATFORM SHADOW PARITY -----
# Off by default. When enabled, mirrors decisions to the new ledger but never
# sends an order through the new platform execution path.
PLATFORM_SHADOW_ENABLED=false
# Example local research ledger: sqlite+pysqlite:////app/data/platform-shadow.sqlite
# Production migration testing should use a dedicated PostgreSQL database.
PLATFORM_DATABASE_URL=
PLATFORM_SHADOW_MAX_STAKE=50
PLATFORM_SHADOW_MIN_PAYOUT=0.70
PLATFORM_SHADOW_MIN_EXPECTANCY=0.0

# ----- DATA DIRECTORY -----
DATA_DIR=/app/data

