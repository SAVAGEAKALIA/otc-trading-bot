# ===========================================
# Git Ignore - OTC Trading Bot
# ===========================================

# ----- SECRETS  -----
.env
*.session
*.session-journal

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ----- Virtual Environments -----
.venv/
venv/
ENV/ env/

# ----- IDE -----
.idea/
.vscode/
*.swp
*.swo
*~

# ----- Logs & Data -----
*.log
trade_log.json
bot_logs.txt
trade_queue.db
session_state.json

# ----- Analysis -----
*_output.txt
deep_analysis_*.txt
deep_micro_*.txt
audit_output.txt
fingerprints.json
fingerprints_*.json
*.txt
*.json

# Keep dependency manifests visible even though generated text reports are
# ignored above.
!requirements*.txt

# ----- Research -----
active_options.py
analyze_*.py
audit_*.py
backtest_*.py
check_*.py
clean_*.py
deep_*.py
diagnostic_*.py
disassemble_pyc.py
extract_strings.py
pyinstxtractor.py
quant_analysis.py
run_analysis.py
ruthless_*.py
simulate_*.py
test_*.py

# ----- Planning & Audits -----
plan-*.md
audit-winrate-assessment.md

# ----- Tests & Scripts -----
/scripts/
# Tests and config are source code and must remain reviewable/versioned.
# These negations override the broad research patterns above
# (test_*.py, *.json, *.txt).
!tests/**/*.py
!trading_platform/**/*.py
!trading_platform/**/*.json
!trading_platform/configs/**

# ----- OS -----
.DS_Store
Thumbs.db

# ----- Temporary -----
*.tmp
*.temp
*.bak
/tmp/

# Runtime data and local tooling state
data/
catboost_info/
.codegraph/
.pytest_cache/
trading_platform/legacy/iqoption_bot/.env

# Model weights and binary artifacts (store outside git)
*.cbm
*.joblib
*.onnx
*.pkl
*.parquet
*.sqlite
trading_platform/research/registry/*.csv
