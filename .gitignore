# ===========================================
# Git Ignore - OTC Trading Bot
# ===========================================

# ----- SECRETS  -----
.env
*.session
*.session-journal

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ----- Virtual Environments -----
.venv/
venv/
ENV/ env/

# ----- IDE -----
.idea/
.vscode/
*.swp
*.swo
*~

# ----- Logs & Data -----
*.log
trade_log.json
bot_logs.txt
trade_queue.db
session_state.json

# ----- Analysis -----
*_output.txt
deep_analysis_*.txt
deep_micro_*.txt
audit_output.txt
fingerprints.json
fingerprints_*.json
*.txt
*.json

# Keep dependency manifests visible even though generated text reports are
# ignored above.
!requirements*.txt

# ----- Research -----
active_options.py
analyze_*.py
audit_*.py
backtest_*.py
check_*.py
clean_*.py
deep_*.py
diagnostic_*.py
disassemble_pyc.py
extract_strings.py
pyinstxtractor.py
quant_analysis.py
run_analysis.py
ruthless_*.py
simulate_*.py
test_*.py

# ----- Planning & Audits -----
plan-*.md
audit-winrate-assessment.md

# ----- Tests & Scripts -----
/scripts/
# Tests and config are source code and must remain reviewable/versioned.
# These negations override the broad research patterns above
# (test_*.py, *.json, *.txt).
!tests/**/*.py
!trading_platform/**/*.py
!trading_platform/**/*.json
!trading_platform/configs/**

# ----- OS -----
.DS_Store
Thumbs.db

# ----- Temporary -----
*.tmp
*.temp
*.bak
/tmp/

# Runtime data and local tooling state
data/
catboost_info/
.codegraph/
.pytest_cache/
trading_platform/legacy/iqoption_bot/.env

# Model weights and binary artifacts (store outside git)
*.cbm
*.joblib
*.onnx
*.pkl
*.parquet
*.sqlite
trading_platform/research/registry/*.csv

# Research evidence (scripts, reports, snapshots, tests) is source and must be versioned.
!docs/research/**
docs/research/**/__pycache__/

# Self-contained R1 research service code, tests and example configuration.
!services/market_data_r1/**/*.py
!services/research_r1/**/*.py
!services/research_r1/config.example.json

!services/archive_transfer_r1/**/*.py

# OTC service source, gates and dependency declaration must survive snapshots.
!contracts/otc_v1/**/*.py
!services/otc_observer/**/*.py
!services/otc_research/**/*.py
!services/otc_research/training_requirements.txt

# Independent fresh observation service and its source fixtures.
!services/otc_collector/**/*.py
!services/otc_collector/requirements.txt

# Independent core comparison and lossless research collection operations.
!services/otc_fresh_compare/**/*.py
!services/otc_collection_ops/**/*.py
!contracts/otc_fresh_v1.py
!original-source-lock.json

# Restored practice runtime keeps sessions, account data and dependencies local.
.venv-otc/
releases/
*.sqlite3
*.sqlite3-*
!services/otc_deterministic_strategies/**/*.py
!services/otc_deterministic_strategies_new/**/*.py

# Frozen strategy definitions and source locks are required by the reproducible evals.
!services/otc_deterministic_strategies/execution_scope_amendment.json
!services/otc_deterministic_strategies/frozen_rules.json
!services/otc_deterministic_strategies/repo_sources.json
!services/otc_deterministic_strategies/source-lock-v2.json
!services/otc_deterministic_strategies/source-lock-v3.json
!services/otc_deterministic_strategies/source-lock-v4.json
!services/otc_deterministic_strategies/source-lock-v5.json
!services/otc_deterministic_strategies/source-lock.json

# D3 accounting contracts, gate tests and periodic evals are source.
!services/spot_trend_r1/**/*.py
!services/spot_trend_r1/contracts/*.json
